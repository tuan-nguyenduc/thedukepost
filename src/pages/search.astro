---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryHref, categoryLabel } from '../lib/categories';
---
<BaseLayout title="Search — The Duke Post" description="Search articles on The Duke Post.">
  <section class="search-page wrap">
    <h1 class="search-title">Search</h1>
    <div class="search-box">
      <input
        id="search-input"
        type="search"
        placeholder="Search articles…"
        autocomplete="off"
        autofocus
        aria-label="Search articles"
      />
    </div>
    <div class="search-filters">
      <label class="search-filter">
        <span>Type</span>
        <select id="filter-type" aria-label="Filter by type">
          <option value="all">All</option>
          <option value="article">Articles</option>
          <option value="wire">Wire</option>
          <option value="newsletter">Newsletter</option>
        </select>
      </label>
      <label class="search-filter">
        <span>Category</span>
        <select id="filter-category" aria-label="Filter by category">
          <option value="all">All</option>
          <option value="ai">AI</option>
          <option value="gadgets">Gadgets</option>
          <option value="startups">Startups</option>
          <option value="security">Security</option>
          <option value="opinion">Opinion</option>
          <option value="general">General</option>
        </select>
      </label>
      <label class="search-filter">
        <span>Sort</span>
        <select id="filter-sort" aria-label="Sort results">
          <option value="relevance">Relevance</option>
          <option value="newest">Newest</option>
        </select>
      </label>
    </div>
    <p id="search-status" class="search-status" aria-live="polite"></p>
    <ul id="search-results" class="results-list" role="listbox"></ul>
    <div id="search-empty" class="empty-state sticker" hidden>
      <p class="empty-state__title">No results found</p>
      <p class="empty-state__hint">Try a different search term, or browse <a href="/articles">all articles</a> and <a href="/wire">the Wire</a> instead.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import Fuse from 'fuse.js';

  interface SearchItem {
    type: 'article' | 'wire' | 'newsletter';
    slug?: string;
    link: string;
    title: string;
    description: string;
    content?: string;
    image?: string;
    category: string;
    pubDate: string;
    readingTime?: string;
  }

  interface RankedResult {
    item: SearchItem;
    matches?: readonly { key?: string; indices: readonly [number, number][] }[];
  }

  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsList = document.getElementById('search-results') as HTMLUListElement;
  const status = document.getElementById('search-status') as HTMLParagraphElement;
  const emptyState = document.getElementById('search-empty') as HTMLDivElement;
  const typeFilter = document.getElementById('filter-type') as HTMLSelectElement;
  const categoryFilter = document.getElementById('filter-category') as HTMLSelectElement;
  const sortFilter = document.getElementById('filter-sort') as HTMLSelectElement;

  let fuse: Fuse<SearchItem> | null = null;
  let allItems: SearchItem[] = [];
  let activeIndex = -1;
  let currentResults: RankedResult[] = [];

  function escapeHtml(str: string): string {
    return str.replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] as string));
  }

  function isSaved(slug: string): boolean {
    try {
      const list = JSON.parse(localStorage.getItem('reading-list') || '[]');
      return Array.isArray(list) && list.some((item) => item.slug === slug);
    } catch {
      return false;
    }
  }

  function highlight(text: string, ranges: readonly [number, number][] | undefined): string {
    if (!ranges || ranges.length === 0) return escapeHtml(text);
    const sorted = [...ranges].sort((a, b) => a[0] - b[0]);
    let html = '';
    let last = 0;
    for (const [start, end] of sorted) {
      if (start < last) continue;
      html += escapeHtml(text.slice(last, start));
      html += `<mark>${escapeHtml(text.slice(start, end + 1))}</mark>`;
      last = end + 1;
    }
    html += escapeHtml(text.slice(last));
    return html;
  }

  function matchRanges(matches: RankedResult['matches'], key: string): readonly [number, number][] | undefined {
    return matches?.find((m) => m.key === key)?.indices;
  }

  async function init() {
    const res = await fetch('/search-index.json');
    const items: SearchItem[] = await res.json();
    allItems = items;
    fuse = new Fuse(items, {
      keys: [
        { name: 'title', weight: 2 },
        { name: 'description', weight: 1 },
        { name: 'content', weight: 0.3 },
        { name: 'category', weight: 0.5 },
      ],
      threshold: 0.4,
      ignoreLocation: true,
      includeMatches: true,
    });

    typeFilter.addEventListener('change', () => runSearch(input.value));
    categoryFilter.addEventListener('change', () => runSearch(input.value));
    sortFilter.addEventListener('change', () => runSearch(input.value));

    const params = new URLSearchParams(window.location.search);
    const q = params.get('q') ?? '';
    if (q) {
      input.value = q;
      runSearch(q);
    }
  }

  function categoryLabel(cat: string): string {
    const labels: Record<string, string> = {
      ai: 'AI', gadgets: 'Gadgets', startups: 'Startups',
      security: 'Security', opinion: 'Opinion', general: 'General',
    };
    return labels[cat] ?? cat;
  }

  function setActive(index: number): void {
    const items = resultsList.querySelectorAll('.result-item');
    items.forEach((el) => el.classList.remove('result-item--active'));
    if (index >= 0 && index < items.length) {
      items[index].classList.add('result-item--active');
      items[index].scrollIntoView({ block: 'nearest' });
    }
    activeIndex = index;
  }

  function renderResults(results: RankedResult[], hasQuery: boolean) {
    currentResults = results;
    activeIndex = -1;
    if (results.length === 0) {
      resultsList.innerHTML = '';
      status.textContent = '';
      emptyState.hidden = !hasQuery;
      return;
    }
    emptyState.hidden = true;
    status.textContent = `${results.length} result${results.length === 1 ? '' : 's'}`;
    resultsList.innerHTML = results.map(({ item, matches }, i) => {
      const isWire = item.type === 'wire';
      const isArticle = item.type === 'article';
      const eyebrow = escapeHtml(
        isWire ? `Wire · ${item.category}` : item.type === 'newsletter' ? 'Newsletter' : categoryLabel(item.category)
      );
      const titleHtml = highlight(item.title, matchRanges(matches, 'title'));
      const descHtml = highlight(item.description, matchRanges(matches, 'description'));
      const linkAttrs = isWire ? ' target="_blank" rel="noopener noreferrer"' : '';
      const byline = item.readingTime ? `${item.pubDate} · ${item.readingTime}` : item.pubDate;
      const saved = isArticle && isSaved(item.slug || '');
      const saveLabel = saved ? 'Remove from reading list' : 'Save to reading list';
      const saveBtn = isArticle ? `
        <button
          type="button"
          class="result-save${saved ? ' is-saved' : ''}"
          data-save-toggle
          data-save-slug="${escapeHtml(item.slug || '')}"
          data-save-title="${escapeHtml(item.title)}"
          data-save-href="${escapeHtml(item.link)}"
          data-save-description="${escapeHtml(item.description)}"
          data-save-image="${escapeHtml(item.image || '')}"
          data-save-category="${escapeHtml(item.category)}"
          data-save-pub-date="${escapeHtml(item.pubDate)}"
          aria-pressed="${saved ? 'true' : 'false'}"
          title="${saveLabel}"
          aria-label="${saveLabel}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg>
        </button>
      ` : '';
      return `
      <li class="result-item" role="option" data-index="${i}">
        <a href="${escapeHtml(item.link)}" class="result-card sticker"${linkAttrs}>
          <span class="result-meta">
            <span class="eyebrow">${eyebrow}</span>
            <span class="byline">${escapeHtml(byline)}</span>
          </span>
          <h2 class="result-title">${titleHtml}</h2>
          <p class="result-desc">${descHtml}</p>
        </a>
        ${saveBtn}
      </li>
    `;
    }).join('');
  }

  function passesFilters(item: SearchItem): boolean {
    if (typeFilter.value !== 'all' && item.type !== typeFilter.value) return false;
    if (categoryFilter.value !== 'all' && !(item.type === 'article' && item.category === categoryFilter.value)) return false;
    return true;
  }

  function runSearch(query: string) {
    if (!fuse) return;
    const q = query.trim();
    const url = new URL(window.location.href);

    if (!q) {
      const hasActiveFilter = typeFilter.value !== 'all' || categoryFilter.value !== 'all';
      if (!hasActiveFilter) {
        resultsList.innerHTML = '';
        status.textContent = '';
        emptyState.hidden = true;
        currentResults = [];
        activeIndex = -1;
        url.searchParams.delete('q');
        window.history.replaceState(null, '', url.toString());
        return;
      }
      const browsed = allItems
        .filter(passesFilters)
        .slice()
        .sort((a, b) => b.pubDate.localeCompare(a.pubDate))
        .map((item) => ({ item }));
      renderResults(browsed, true);
      url.searchParams.delete('q');
      window.history.replaceState(null, '', url.toString());
      return;
    }

    let ranked: RankedResult[] = fuse
      .search(q)
      .filter((r) => passesFilters(r.item))
      .map((r) => ({ item: r.item, matches: r.matches }));
    if (sortFilter.value === 'newest') {
      ranked = ranked.slice().sort((a, b) => b.item.pubDate.localeCompare(a.item.pubDate));
    }
    renderResults(ranked, true);
    url.searchParams.set('q', q);
    window.history.replaceState(null, '', url.toString());
  }

  input.addEventListener('input', () => runSearch(input.value));

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(Math.min(activeIndex + 1, currentResults.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(Math.max(activeIndex - 1, 0));
    } else if (e.key === 'Enter') {
      if (activeIndex >= 0 && currentResults[activeIndex]) {
        e.preventDefault();
        const item = currentResults[activeIndex].item;
        if (item.type === 'wire') {
          window.open(item.link, '_blank', 'noopener,noreferrer');
        } else {
          window.location.href = item.link;
        }
      }
    }
  });

  init();
</script>

<style>
  .search-page {
    padding: 48px 24px 80px;
    max-width: 720px;
  }
  .search-title {
    font-size: clamp(32px, 5vw, 48px);
    margin-bottom: 28px;
  }
  .search-box {
    margin-bottom: 16px;
  }
  #search-input {
    width: 100%;
    padding: 14px 18px;
    font-size: 18px;
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--ink);
    outline: none;
    transition: box-shadow 0.15s ease;
  }
  #search-input:focus {
    box-shadow: 4px 4px 0 var(--signal);
    border-color: var(--signal);
  }
  .search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 8px;
  }
  .search-filter {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--slate);
  }
  .search-filter select {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 4px 8px;
    cursor: pointer;
  }
  .search-status {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--slate);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 24px;
    min-height: 18px;
  }
  .results-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /*
   * :global() below because results-list's <li> children are injected via
   * innerHTML at runtime (see the <script> above) — Astro only stamps its
   * data-astro-cid scoping attribute onto elements it compiles at build
   * time, so a scoped selector would never match these nodes.
   */
  :global(.result-item) { position: relative; }
  :global(.result-card) {
    display: block;
    padding: 22px 60px 22px 24px;
  }
  :global(.result-save) {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  :global(.result-save svg) { width: 16px; height: 16px; }
  :global(.result-save:hover) { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  :global(.result-save.is-saved) { background: var(--signal); border-color: var(--signal); color: var(--ink-fixed); }
  :global(.result-save.is-saved svg) { fill: currentColor; }
  :global(.result-meta) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  :global(.result-title) {
    font-size: 22px;
    margin-bottom: 8px;
  }
  :global(.result-desc) {
    color: var(--slate);
    font-size: 15px;
    margin: 0;
  }
  :global(.result-title mark),
  :global(.result-desc mark) {
    background: var(--accent-soft);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }
  :global(.result-item--active .result-card) {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .empty-state {
    padding: 28px 24px;
    text-align: center;
  }
  .empty-state__title {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .empty-state__hint {
    color: var(--slate);
    font-size: 15px;
    margin: 0;
  }
  .empty-state__hint a { color: var(--accent); border-bottom: 2px solid var(--accent-soft); }
  .empty-state__hint a:hover { border-color: var(--accent); }
</style>
