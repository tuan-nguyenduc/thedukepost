---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, categoryLabel, categoryHref } from '../../../lib/categories';

const articles = await getCollection('articles', ({ data }) => !data.draft);

const categoryCounts = new Map<string, number>();
for (const article of articles) {
  categoryCounts.set(article.data.category, (categoryCounts.get(article.data.category) ?? 0) + 1);
}

const categories = CATEGORIES.map((category) => ({
  slug: category,
  label: categoryLabel(category),
  count: categoryCounts.get(category) ?? 0,
}));
---
<BaseLayout
  title="Categories — The Duke Post"
  description="Browse The Duke Post's original articles by category."
>
  <section class="wrap page">
    <p class="back"><a href="/articles">← All articles</a></p>
    <h1>Categories</h1>
    <div class="category-cloud">
      {categories.map((category) => (
        <a href={categoryHref(category.slug)} class="category-chip sticker">
          {category.label} <span class="category-count">{category.count}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 48px 24px 80px; }
  .back { font-family: var(--font-mono); font-size: 13px; margin-bottom: 18px; }
  .back a { color: var(--slate); }
  .back a:hover { color: var(--ink); }
  h1 { font-size: 36px; margin-bottom: 36px; }
  .category-cloud { display: flex; flex-wrap: wrap; gap: 12px; }
  .category-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    font-size: 15px;
  }
  .category-count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--slate);
  }
</style>
